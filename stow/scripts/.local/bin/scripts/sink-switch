#!/bin/bash
get_sink_id() {
  local name="$*"

  wpctl status | awk -v name="$name" '
    /^[[:space:]]*├─ Sinks:/ {ins=1; next}
    ins && /^[[:space:]]*├─ [A-Za-z]/ { ins=0 }
    ins && index($0, name) {
      if (match($0, /[0-9]+\./)) {
        num = substr($0, RSTART, RLENGTH-1)
        print num
      }
    }
  ' | head -n1
}

arg="${1:-}"
case "$arg" in
  --speakers)
    SINK="AudioBox USB 96 Analog Stereo"
    SINK_NUMBER=$(get_sink_id $SINK)
    wpctl set-default "$SINK_NUMBER"
    notify-send "Switched to speakers!"
    ;;
  --headphones)
    SINK="Arctis Pro Wireless Game"
    SINK_NUMBER=$(get_sink_id $SINK)
    wpctl set-default "$SINK_NUMBER"
    notify-send "Switched to headphones!"
    ;;
  --bluetooth)
    SINK="bluez_sink.BC_87_FA_58_F6_20.a2dp_sink"
    pacmd set-default-sink "$SINK"
    pacmd list-sink-inputs | grep index | while read line; do
      pacmd move-sink-input `echo $line | cut -f2 -d' '` "$SINK"
    done
    notify-send "Switched to Bluetooth!"
    ;;
  *)

    # Setting this as the default lets polybar call the script and display
    # an icon of some sort on the icon bar. The character I used isn't
    # showing up right on this non-linux machine I'm using, so replace "X"
    # with whatever character or symbol you want on your polybar.
    echo "X"
    ;;
esac

