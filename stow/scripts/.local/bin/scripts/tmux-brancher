#!/usr/bin/env bash

set -euo pipefail

FZF_CMD="fzf"
if [[ "${1:-}" == "--popup" ]]; then
    FZF_CMD="fzf-tmux -p 80%,70%"
fi

branch_name=$(echo "" | $FZF_CMD --print-query --prompt="Branch name> " | tail -1) || true
[ -z "$branch_name" ] && exit 1

project_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    is_bare=$(git rev-parse --is-bare-repository 2>/dev/null)
    [[ "$is_bare" != "true" ]] && exit 1
    project_root=$(git rev-parse --git-dir)
}

cd "$project_root"

is_bare=$(git rev-parse --is-bare-repository 2>/dev/null)

if [[ "$is_bare" == "true" ]] || { [[ -f .git ]] && grep -q 'bare = true' "$(git rev-parse --git-common-dir)/config" 2>/dev/null; }; then
    wt switch --create "$branch_name"
    worktree_path=$(git worktree list | awk -v b="$branch_name" '$3 == "["b"]" {print $1}')
    sesh connect "$worktree_path"
else
    default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@.*/@@')
    [ -z "$default_branch" ] && default_branch=$(git remote show origin 2>/dev/null | grep 'HEAD branch' | awk '{print $NF}')
    [ -z "$default_branch" ] && default_branch="main"
    git fetch origin "$default_branch"
    git checkout -b "$branch_name" "origin/$default_branch"
fi
